<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="12dp"
    android:background="@color/gray_200">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔍 Smart Tracker"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/blue_700"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Real-time ESP32 tracking system"
            android:textSize="14sp"
            android:textColor="@color/gray_700"
            android:layout_marginBottom="16dp"
            android:gravity="center" />

        <!-- Connection Status Card - NEW IMPROVED -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:elevation="4dp"
            android:radius="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📡 Connection Status"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/blue_700"
                    android:layout_marginBottom="8dp" />

                <!-- Overall Status -->
                <TextView
                    android:id="@+id/connectionStatusCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🔴 Disconnected"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/red_500"
                    android:layout_marginBottom="8dp" />

                <!-- Individual Connection Status -->
                <TextView
                    android:id="@+id/bleStatusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🔵 BLE: Disconnected"
                    android:textSize="14sp"
                    android:textColor="@color/red_500"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/wifiStatusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📶 WiFi: Ready"
                    android:textSize="14sp"
                    android:textColor="@color/gray_500"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/gsmStatusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📱 GSM: Ready"
                    android:textSize="14sp"
                    android:textColor="@color/gray_500"
                    android:layout_marginBottom="8dp" />

                <!-- Quick Retry Buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/retryBleButton"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:text="🔵 BLE"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:background="@color/blue_600"
                        android:layout_marginEnd="4dp" />

                    <Button
                        android:id="@+id/retryWifiButton"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:text="📶 WiFi"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:background="@color/dark_green"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp" />

                    <Button
                        android:id="@+id/retryGsmButton"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:text="📱 GSM"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:background="@color/red_600"
                        android:layout_marginStart="4dp" />

                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Control Buttons - MOVED UP -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/startButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="🚀 START"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:background="@color/green_500"
                android:layout_marginEnd="8dp"
                android:enabled="false" />

            <Button
                android:id="@+id/stopButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="⏹️ STOP"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:background="@color/red_500"
                android:layout_marginStart="8dp"
                android:enabled="false" />

        </LinearLayout>

        <!-- Alarm Control Card - SIMPLIFIED -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:elevation="4dp"
            android:radius="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🚨 Alarm Control"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/blue_700"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:id="@+id/alarmStatusText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🔔 ENABLED (ready)"
                        android:textSize="16sp"
                        android:textColor="@color/green_500"
                        android:textStyle="bold" />

                    <Switch
                        android:id="@+id/alarmSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:minWidth="48dp"
                        android:minHeight="48dp" />

                </LinearLayout>

                <Button
                    android:id="@+id/silenceButton"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="🔇 SILENCE ALARM"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:background="@color/red_500"
                    android:enabled="false" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- RSSI Calibration Card - SIMPLIFIED -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:elevation="4dp"
            android:radius="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📡 Distance Calibration"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/blue_700"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/rssiTestText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📡 RSSI Threshold: -70 dBm"
                    android:textSize="14sp"
                    android:textColor="@color/gray_700"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/rssiTestButton"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:text="📡 RSSI TEST"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:background="@color/blue_500"
                        android:layout_marginEnd="8dp"
                        android:enabled="false" />

                    <Button
                        android:id="@+id/setThresholdButton"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:text="✅ SET"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:background="@color/green_500"
                        android:layout_marginStart="8dp"
                        android:enabled="false" />

                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Status Card - COMPACT -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:elevation="4dp"
            android:radius="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📊 System Status"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/blue_700"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Status: Initializing..."
                    android:textSize="14sp"
                    android:textColor="@color/gray_700"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/gpsStatusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="GPS: Not available"
                    android:textSize="14sp"
                    android:textColor="@color/gray_500" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Enhanced Debug Console - BIGGER -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:elevation="4dp"
            android:radius="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🐛 Debug Console"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/blue_700" />

                    <Button
                        android:id="@+id/clearLogButton"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:text="CLEAR"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:background="@color/gray_500"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:paddingLeft="12dp"
                        android:paddingRight="12dp" />

                </LinearLayout>

                <!-- Larger Scrollable Debug Console -->
                <ScrollView
                    android:id="@+id/debugScrollView"
                    android:layout_width="match_parent"
                    android:layout_height="400dp"
                    android:background="#FF1E1E1E"
                    android:padding="8dp"
                    android:scrollbars="vertical"
                    android:fadeScrollbars="false"
                    android:scrollbarStyle="outsideOverlay">

                    <TextView
                        android:id="@+id/debugLogText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="12sp"
                        android:textColor="#FF00FF00"
                        android:fontFamily="monospace"
                        android:textIsSelectable="true"
                        android:lineSpacingExtra="2dp"
                        android:paddingBottom="8dp" />

                </ScrollView>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="💡 Auto-scroll enabled | Shows last 50 events | Reduced spam"
                    android:textSize="10sp"
                    android:textColor="@color/gray_500"
                    android:layout_marginTop="4dp"
                    android:fontStyle="italic"
                    android:gravity="center" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Quick Info Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:elevation="4dp"
            android:radius="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📋 Quick Guide"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/blue_700"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="1️⃣ Press START to begin tracking\n2️⃣ Use RSSI TEST to calibrate distance\n3️⃣ Enable/disable alarm with switch\n4️⃣ Monitor connections above\n5️⃣ Check debug console for details"
                    android:textSize="13sp"
                    android:textColor="@color/gray_700"
                    android:lineSpacingExtra="2dp" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- App Info -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Smart Tracker v1.1 - Improved UI"
            android:textSize="12sp"
            android:textColor="@color/gray_500"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚠️ Real sensor data - No spam logs"
            android:textSize="11sp"
            android:textColor="@color/gray_500"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

    </LinearLayout>

</ScrollView>