<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="12dp"
    android:background="@color/gray_200">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SmartTracker"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/blue_700"
            android:layout_marginBottom="16dp" />

        <!-- Connection Status Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:elevation="4dp"
            android:radius="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Connection Status"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/blue_700"
                    android:layout_marginBottom="8dp" />

                <!-- Overall Status -->
                <TextView
                    android:id="@+id/connectionStatusCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Searching for ESP32..."
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/red_500"
                    android:layout_marginBottom="8dp" />

                <!-- Individual Connection Status -->
                <TextView
                    android:id="@+id/bleStatusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="BLE: Searching..."
                    android:textSize="14sp"
                    android:textColor="@color/red_500"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/wifiStatusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="WiFi: Not connected"
                    android:textSize="14sp"
                    android:textColor="@color/red_500"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/gsmStatusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="GSM: No network"
                    android:textSize="14sp"
                    android:textColor="@color/red_500"
                    android:layout_marginBottom="8dp" />

                <!-- Quick Retry Buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/retryBleButton"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:text="RETRY BLE"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:background="@color/blue_600"
                        android:layout_marginEnd="4dp" />

                    <Button
                        android:id="@+id/retryWifiButton"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:text="TEST WiFi"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:background="@color/dark_green"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp" />

                    <Button
                        android:id="@+id/retryGsmButton"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:text="TEST GSM"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:background="@color/red_600"
                        android:layout_marginStart="4dp" />

                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Control Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/startButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="START TRACKING"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:background="@color/green_500"
                android:layout_marginEnd="8dp"
                android:enabled="false" />

            <Button
                android:id="@+id/stopButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="STOP TRACKING"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:background="@color/red_500"
                android:layout_marginStart="8dp"
                android:enabled="false" />

        </LinearLayout>

        <!-- Alarm Control Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:elevation="4dp"
            android:radius="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Alarm System"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/blue_700"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:id="@+id/alarmStatusText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="ENABLED (monitoring)"
                        android:textSize="16sp"
                        android:textColor="@color/green_500"
                        android:textStyle="bold" />

                    <Switch
                        android:id="@+id/alarmSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:minWidth="48dp"
                        android:minHeight="48dp" />

                </LinearLayout>

                <Button
                    android:id="@+id/silenceButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="SILENCE ALARM"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:background="@color/red_500"
                    android:enabled="true" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Distance Calibration Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:elevation="4dp"
            android:radius="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Distance Configuration"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/blue_700"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/rssiTestText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Alert Distance: -70 dBm"
                    android:textSize="14sp"
                    android:textColor="@color/gray_700"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <!-- Manual Threshold Selection -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Set Distance:"
                        android:textSize="14sp"
                        android:textColor="@color/gray_700"
                        android:layout_marginEnd="8dp" />

                    <Spinner
                        android:id="@+id/thresholdSpinner"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minHeight="48dp" />

                </LinearLayout>

                <!-- Distance Test Buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/rssiTestButton"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:text="START DISTANCE TEST"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:background="@color/blue_500"
                        android:layout_marginEnd="8dp"
                        android:enabled="false" />

                    <Button
                        android:id="@+id/setThresholdButton"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:text="SET CURRENT"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:background="@color/green_500"
                        android:layout_marginStart="8dp"
                        android:enabled="false" />

                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- GPS Location Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:elevation="4dp"
            android:radius="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GPS Location"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/blue_700"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/gpsStatusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="GPS: Not available"
                    android:textSize="14sp"
                    android:textColor="@color/gray_500"
                    android:layout_marginBottom="8dp" />

                <Button
                    android:id="@+id/requestGpsButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="REQUEST GPS LOCATION"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:background="@color/blue_600"
                    android:enabled="false" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Status Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:elevation="4dp"
            android:radius="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="System Status"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/blue_700"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Status: Initializing..."
                    android:textSize="14sp"
                    android:textColor="@color/gray_700" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Debug Console -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:elevation="4dp"
            android:radius="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Debug Console"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/blue_700" />

                    <Button
                        android:id="@+id/clearLogButton"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:text="CLEAR"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:background="@color/gray_500"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:paddingLeft="12dp"
                        android:paddingRight="12dp" />

                </LinearLayout>

                <ScrollView
                    android:id="@+id/debugScrollView"
                    android:layout_width="match_parent"
                    android:layout_height="400dp"
                    android:background="#FF1E1E1E"
                    android:scrollbars="vertical"
                    android:fadeScrollbars="false">

                    <TextView
                        android:id="@+id/debugLogText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="11sp"
                        android:textColor="#FF00FF00"
                        android:fontFamily="monospace"
                        android:padding="8dp"
                        android:gravity="top"
                        android:textIsSelectable="false" />

                </ScrollView>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="LATEST MESSAGES AT TOP | Last 25 messages | Real data only"
                    android:textSize="10sp"
                    android:textColor="@color/gray_500"
                    android:layout_marginTop="4dp"
                    android:fontStyle="italic"
                    android:gravity="center" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- How to Use Guide -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:elevation="4dp"
            android:radius="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="How to Use"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/blue_700"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="1. START TRACKING - Begin monitoring device distance\n2. Set alert distance using dropdown or distance test\n3. SILENCE ALARM - Stop buzzer for 5 minutes\n4. REQUEST GPS - Get current location\n5. Alarm controls buzzer only\n6. Notifications sent when tracking is active"
                    android:textSize="13sp"
                    android:textColor="@color/gray_700"
                    android:lineSpacingExtra="2dp" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- App Info -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SmartTracker - Real hardware tracking system"
            android:textSize="12sp"
            android:textColor="@color/gray_500"
            android:layout_marginBottom="16dp"
            android:gravity="center" />

    </LinearLayout>

</ScrollView>